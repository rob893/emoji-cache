{
  "name": "rob893/emoji-cache",
  "description": "LRU cache implementation but all identifiers are emojis.",
  "type": "library",
  "keywords": [
    "LRU",
    "cache",
    "emoji",
    "crime against programming",
    "php"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Robert Herber",
      "email": "rwherber@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "rob893\\EmojiCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "rob893\\EmojiCache\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "check": [
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
